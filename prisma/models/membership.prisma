model Membership {
  id              String                    @id @default(uuid())
  name            String                    @unique @db.VarChar(100)
  description     String                    @db.VarChar(255)
  price           Int
  created_at      DateTime                  @default(now()) @map("created_at")
  updated_at      DateTime                  @updatedAt @map("updated_at")
  functionalities MembershipFunctionality[]
  subscription    Subscription[]

  @@map("membership")
}

model Functionality {
  id          String                    @id @default(uuid())
  name        String                    @unique @db.VarChar(100)
  created_at  DateTime                  @default(now()) @map("created_at")
  updated_at  DateTime                  @updatedAt @map("updated_at")
  memberships MembershipFunctionality[]

  @@map("functionality")
}

model MembershipFunctionality {
  membership_id    String        @map("membership_id")
  functionality_id String        @map("functionality_id")
  created_at       DateTime      @default(now()) @map("created_at")
  updated_at       DateTime      @updatedAt @map("updated_at")
  functionality    Functionality @relation(fields: [functionality_id], references: [id], onDelete: Cascade)
  membership       Membership    @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  @@id([membership_id, functionality_id])
  @@map("membership_functionality")
}
