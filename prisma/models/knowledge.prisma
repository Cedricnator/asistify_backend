model DocumentType {
  id         String     @id @default(uuid())
  name       String     @unique @db.VarChar(100)
  created_at DateTime   @default(now()) @map("created_at")
  updated_at DateTime   @updatedAt @map("updated_at")
  Document   Document[]

  @@map("document_type")
}

model Document {
  id                String       @id @default(uuid())
  original_name     String       @db.VarChar(255)
  extension_content String       @db.VarChar(50)
  size              Int
  file_path         String       @db.Text
  name              String       @db.VarChar(255)
  document_type_id  String       @map("document_type_id")
  enterprise_id     String       @map("enterprise_id")
  created_at        DateTime     @default(now()) @map("created_at")
  updated_at        DateTime     @updatedAt @map("updated_at")
  document_type     DocumentType @relation(fields: [document_type_id], references: [id], onDelete: Cascade)
  enterprise        Enterprise   @relation(fields: [enterprise_id], references: [id], onDelete: Cascade)

  document_chunks DocumentChunk[]

  @@map("document")
}

model DocumentChunk {
  id          String                      @id @default(uuid())
  index       Int
  content     String                      @db.Text
  embedding   Unsupported("vector(1536)")
  keywords    String[]                    @db.Text
  metadata    Json                        @db.JsonB
  document_id String                      @map("document_id")
  document_chunk_type_id String           @map("document_chunk_type_id")
  created_at  DateTime                    @default(now()) @map("created_at")

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  document_chunk_type DocumentChunkType @relation(fields: [document_chunk_type_id], references: [id], onDelete: Cascade)

  @@map("document_chunk")
}

model DocumentChunkType {
  id          String     @id @default(uuid())
  name        String     @unique @db.VarChar(100)
  created_at  DateTime   @default(now()) @map("created_at")
  updated_at  DateTime   @updatedAt @map("updated_at")
  DocumentChunk DocumentChunk[]

  @@map("document_chunk_type")
}
