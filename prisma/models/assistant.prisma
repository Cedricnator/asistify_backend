model Recepcionist {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(100)
  avatar    String?  @db.Text()
  cellphone  String  @db.VarChar(15)
  enterprise_information String @db.VarChar(255)
  client_information    String @db.VarChar(255)
  business_restrictions   String @db.VarChar(255)
  level_formality Int
  level_dinamism   Int
  max_days_antecipation Int
  antecipation_reservation_min_level Int
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  enterprise_id String @map("enterprise_id")

  enterprise Enterprise @relation(fields: [enterprise_id], references: [id])
  metrics Metric[]

  @@map("recepcionist")
}

model Metric {
  id         String   @id @default(cuid())
  model_used String   @db.VarChar(100)
  token_usage Int
  response_time Float
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  recepcionist_id String @map("recepcionist_id")

  assistant Recepcionist @relation(fields: [recepcionist_id], references: [id])
  @@map("metric")
}
